{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.dev ./node_modules/prisma/build/index.js generate && node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:migrate:dev": "node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate",
    "db:verify-seed": "VERIFY_DATABASE_SEED=true vitest run tests/infrastructure/prisma/seed/trade-seeder.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.12",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.2"
  }
}
