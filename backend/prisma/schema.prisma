generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  ACTIVE
  CANCELLED
}

model Trade {
  id           String      @id @default(cuid()) @db.VarChar(32)
  symbol       String      @db.VarChar(16)
  quantity     Int
  price        Decimal     @db.Decimal(18, 4)
  side         TradeSide
  trader       String      @db.VarChar(32)
  tradeDate    DateTime    @db.Timestamptz(3)
  status       TradeStatus @default(ACTIVE)
  book         String?     @db.VarChar(64)
  counterparty String?     @db.VarChar(120)

  @@index([tradeDate])
}